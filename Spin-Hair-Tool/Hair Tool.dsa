// The Spin256 name, logo and icon are not licensed for reuse; see ADDITIONAL_TERMS.md.
// Staged scene selection for the Spin Hair Tool.
// Colour markers and role labels belong to this dialog's tree.
(function () {
    var title = "Spin Hair Tool";
    var folder = typeof spinHairFolder === "string" ? spinHairFolder :
        String(getScriptFileName()).replace(/\\/g, "/").replace(/[^\/]*$/, "");
    if (!folder) {
        MessageBox.warning("Run the saved Hair Tool.dsa file or reinstall its menu item.", title, "OK", "");
        return;
    }
    var stage = 0;
    var sourceFrame = Scene.getFrame();
    var timelineStart;
    var timelineEnd;
    try {
        var frameTicks = Scene.getTimeStep().valueOf();
        var timeline = Scene.getAnimRange();
        timelineStart = Math.ceil(timeline.start.valueOf() / frameTicks - 1e-8);
        timelineEnd = Math.floor(timeline.end.valueOf() / frameTicks + 1e-8);
        if (!isFinite(frameTicks) || frameTicks <= 0 || !isFinite(timelineStart) ||
                !isFinite(timelineEnd) || timelineEnd < timelineStart) {
            throw new Error("Could not read the DAZ timeline range and frame rate.");
        }
    } catch (error) {
        MessageBox.warning(error.message, title, "OK", "");
        return;
    }
    var records = [];
    var byNodeId = {};
    var roles = ["collision", "avatar", "garment"];
    var labels = {
        collision: "Collision object",
        avatar: "Avatar",
        avatar_attachment: "Avatar attached mesh",
        garment: "Hair"
    };
    var colors = {
        collision: new Color(170, 170, 170),
        avatar: new Color(180, 110, 230),
        avatar_attachment: new Color(180, 110, 230),
        garment: new Color(70, 160, 255)
    };
    var markers = {};

    function marker(color) {
        var pixmap = new Pixmap();
        pixmap.resize(14, 14);
        pixmap.fill(color);
        return pixmap;
    }
    for (var role in colors) {
        markers[role] = marker(colors[role]);
    }
    markers.none = marker(new Color(65, 65, 65));

    var dialog = new DzBasicDialog();
    dialog.caption = title + " - Scene Selection";
    dialog.getWidget().objectName = "SpinHairSceneSelection";
    dialog.minWidth = 720;
    dialog.minHeight = 620;
    dialog.sizeGripEnabled = true;
    dialog.showHelpButton(false);
    dialog.showApplyButton(false);
    dialog.setAcceptButtonText("Open Hair Tool");
    dialog.setCancelButtonText("Cancel");

    var heading = new DzLabel(dialog);
    heading.textFormat = DzLabel.PlainText;
    dialog.addWidget(heading);
    var legend = new DzLabel(dialog);
    legend.textFormat = DzLabel.RichText;
    legend.text = '<span style="color:#aaaaaa">Grey - Collision objects</span> &nbsp; ' +
        '<span style="color:#b46ee6">Purple - Avatar</span> &nbsp; ' +
        '<span style="color:#46a0ff">Blue - Hair</span>';
    dialog.addWidget(legend);
    var instructions = new DzLabel(dialog);
    instructions.textFormat = DzLabel.PlainText;
    instructions.wordWrap = true;
    dialog.addWidget(instructions);

    var tree = new DzListView(dialog);
    tree.addColumn("Scene object");
    tree.addColumn("Assigned role");
    tree.addColumn("Geometry");
    tree.setColumnWidth(0, 340);
    tree.setColumnWidth(1, 160);
    tree.setColumnWidth(2, 120);
    tree.setSorting(-1);
    tree.rootIsDecorated = true;
    tree.selectionMode = DzListView.Extended;
    tree.minHeight = 320;
    dialog.addWidget(tree, 1);

    var actions = new DzWidget(dialog);
    var actionLayout = new DzHBoxLayout(actions);
    var assign = new DzPushButton(actions);
    assign.autoDefault = false;
    actionLayout.addWidget(assign);
    var remove = new DzPushButton(actions);
    remove.text = "Remove selected assignment";
    remove.autoDefault = false;
    actionLayout.addWidget(remove);
    dialog.addWidget(actions);

    var summary = new DzLabel(dialog);
    summary.textFormat = DzLabel.PlainText;
    summary.wordWrap = true;
    dialog.addWidget(summary);
    var animation = new DzCheckBox(dialog);
    animation.text = "Use timeline movement";
    animation.checked = false;
    dialog.addWidget(animation);
    var startLabel = new DzLabel(dialog);
    startLabel.text = "Movement start frame";
    dialog.addWidget(startLabel);
    function frameControl(value) {
        var control = new DzIntSlider(dialog);
        // Expand the initial bounds first, including timelines that start above
        // the widget's default maximum or use a negative starting frame.
        control.min = Math.min(0, timelineStart);
        control.max = Math.max(0, timelineEnd);
        control.min = timelineStart;
        control.max = timelineEnd;
        control.clamped = true;
        control.textVisible = true;
        control.textEditable = true;
        control.fullLengthEdit = true;
        control.value = Math.max(timelineStart, Math.min(timelineEnd, value));
        control.toolTip = "Frames " + timelineStart + " through " + timelineEnd +
            ". Click the frame number to type a value.";
        return control;
    }
    var startFrame = frameControl(0);
    dialog.addWidget(startFrame);
    var endLabel = new DzLabel(dialog);
    endLabel.text = "Movement end frame";
    dialog.addWidget(endLabel);
    var endFrame = frameControl(Math.max(startFrame.value + 1, sourceFrame));
    dialog.addWidget(endFrame);
    var returnAnimation = new DzCheckBox(dialog);
    returnAnimation.text = "Prefer an animation sequence on return";
    returnAnimation.checked = false;
    returnAnimation.toolTip = "Prepopulates the helper's return preference. The helper can change this independently of input movement.";
    dialog.addWidget(returnAnimation);
    var reviewControls = [animation, startLabel, startFrame, endLabel, endFrame, returnAnimation];
    var note = new DzLabel(dialog);
    note.textFormat = DzLabel.PlainText;
    note.wordWrap = true;
    dialog.addWidget(note);

    var back = new DzPushButton(dialog);
    back.text = "Back";
    back.autoDefault = false;
    dialog.addButton(back, 0);
    var next = new DzPushButton(dialog);
    next.text = "Next";
    next.autoDefault = false;
    dialog.addButton(next, 1);

    function hasMesh(node) {
        var object = node.getObject();
        var mesh = object ? object.getCachedGeom() : null;
        if (!mesh && object && object.getCurrentShape()) {
            mesh = object.getCurrentShape().getGeometry();
        }
        return !!(mesh && mesh.inherits("DzFacetMesh") && mesh.getNumFacets() > 0);
    }

    function geometryLabel(node) {
        if (hasMesh(node)) return "Own mesh";
        var object = node.getObject();
        if (!object) return "Container / bone";
        var mesh = object.getCachedGeom();
        if (!mesh && object.getCurrentShape()) mesh = object.getCurrentShape().getGeometry();
        return mesh ? "Unsupported" : "Container / bone";
    }

    function addNode(node) {
        if (byNodeId[node.elementID]) {
            return byNodeId[node.elementID];
        }
        var parent = node.getNodeParent();
        var parentRecord = parent ? addNode(parent) : null;
        var index = records.length;
        var item = new DzListViewItem(parentRecord ? parentRecord.item : tree, index);
        var mesh = hasMesh(node);
        var record = { node: node, item: item, mesh: mesh, role: "", parent: parentRecord };
        records.push(record);
        byNodeId[node.elementID] = record;
        item.setText(0, node.getLabel());
        item.setText(2, geometryLabel(node));
        item.selectable = mesh;
        item.open = !parentRecord;
        return record;
    }

    function refresh() {
        var count = { collision: 0, avatar: 0, avatar_attachment: 0, garment: 0 };
        var visible = {};
        for (var i = 0; i < records.length; i++) {
            var record = records[i];
            record.item.setText(1, record.role ? labels[record.role] : "Unassigned");
            record.item.setPixmap(1, markers[record.role || "none"]);
            if (record.role) {
                count[record.role]++;
                var ancestor = record;
                while (ancestor) {
                    visible[ancestor.node.elementID] = true;
                    ancestor = ancestor.parent;
                }
            }
        }
        for (var v = 0; v < records.length; v++) {
            records[v].item.visible = stage !== 3 || !!visible[records[v].node.elementID];
            if (stage === 3 && visible[records[v].node.elementID]) {
                records[v].item.open = true;
            }
        }
        var headings = [
            "Stage 1 of 4 - Collision objects",
            "Stage 2 of 4 - Avatar",
            "Stage 3 of 4 - Hair to simulate",
            "Stage 4 of 4 - Review and send"
        ];
        heading.text = headings[stage];
        if (stage < 3) {
            heading.paletteForegroundColor = colors[roles[stage]];
            assign.text = "Assign selected as " + labels[roles[stage]];
            instructions.text = "Select one or more mesh rows, then click Assign selected. " +
                "Ctrl-click selects multiple objects. Double-click also assigns an object. " +
                "An assignment includes only that object's own mesh.";
            if (stage === 1) instructions.text = "Assign the main figure by itself first as Avatar. Then assign one or more fitted clothing or accessory meshes here as attached Avatar meshes. " +
                "Independent objects such as beds or removable hats belong in Collision objects. " +
                "Remove the main Avatar assignment before choosing a different figure.";
        } else {
            heading.paletteForegroundColor = new Color(220, 220, 220);
            instructions.text = "Review the exact objects below. Use Back to change their roles. " +
                "No unassigned objects or automatically selected children will be exported.";
        }
        assign.enabled = stage < 3;
        back.enabled = stage > 0;
        next.enabled = stage < 3 && (stage !== 1 || count.avatar === 1);
        // Hair is optional: an avatar on its own is captured to grow hair on it.
        var valid = count.avatar === 1;
        for (var c = 0; c < reviewControls.length; c++) {
            if (stage === 3) {
                reviewControls[c].show();
            } else {
                reviewControls[c].hide();
            }
        }
        startFrame.enabled = animation.checked;
        endFrame.enabled = animation.checked;
        var validRange = !animation.checked || (endFrame.value > startFrame.value &&
            startFrame.value >= timelineStart && endFrame.value <= timelineEnd);
        dialog.setAcceptButtonEnabled(stage === 3 && valid && validRange);
        summary.text = "Collision objects: " + count.collision + "    Avatar: " + count.avatar +
            " + " + count.avatar_attachment + " attached" +
            "    Hair: " + count.garment + "    Capture frame: " + Scene.getFrame() +
            "\nTimeline: " + timelineStart + " through " + timelineEnd + ". Click a frame number to type it.";
        if ((stage === 1 || stage === 3) && count.avatar === 0) {
            summary.text += "\nAssign the main figure as Avatar to continue. Clothing can then be attached here.";
        } else if (count.avatar > 1) {
            summary.text += "\nOnly one Avatar is allowed. Remove the extra Avatar assignments; assign clothing and props as Collision objects.";
        }
        if (stage === 3 && count.garment === 0) {
            summary.text += "\nNo hair assigned: the avatar is captured on its own, to grow hair on it in the Hair tool.";
        }
        if (animation.checked) {
            note.text = validRange ?
                "Timeline movement defaults to frames " + startFrame.value + " through " + endFrame.value +
                ". The hair is captured at the start; the avatar and collision objects are captured at every frame; the helper settles the hair, then plays the movement. " +
                "The original DAZ frame is restored after capture." :
                "The movement end frame must be later than the start frame.";
        } else {
            note.text = "Current-frame hair simulation at frame " + sourceFrame +
                ". The settled hair is sent back as a static mesh. Tick Use timeline movement to animate the hair through a movement.";
        }
    }

    function assignItems(selected) {
        if (stage >= 3) {
            return;
        }
        var meshes = [];
        for (var m = 0; m < selected.length; m++) {
            if (records[selected[m].id] && records[selected[m].id].mesh) meshes.push(records[selected[m].id]);
        }
        var primary = null;
        for (var a = 0; a < records.length; a++) if (records[a].role === "avatar") primary = records[a];
        if (stage === 1) {
            if (!meshes.length) {
                MessageBox.warning("Select the main figure first, then its attached clothing or accessories.", title, "OK", "");
                return;
            }
            if (!primary && meshes.length > 1) {
                MessageBox.warning("Assign the main figure by itself first, so the hair knows which head to follow. Then select one or more clothing or accessory meshes and assign them to the Avatar group.", title, "OK", "");
                return;
            }
        }
        for (var i = 0; i < selected.length; i++) {
            var record = records[selected[i].id];
            if (record && record.mesh) {
                if (stage === 1) {
                    record.role = !primary || record === primary ? "avatar" : "avatar_attachment";
                    if (!primary) primary = record;
                } else record.role = roles[stage];
            }
        }
        refresh();
    }

    function assignSelected() {
        assignItems(tree.getItems(DzListView.Selected));
    }

    connect(assign, "clicked()", assignSelected);
    connect(animation, "toggled(bool)", refresh);
    connect(startFrame, "valueChanged(int)", refresh);
    connect(endFrame, "valueChanged(int)", refresh);
    connect(remove, "clicked()", function () {
        var selected = tree.getItems(DzListView.Selected);
        for (var i = 0; i < selected.length; i++) {
            records[selected[i].id].role = "";
        }
        refresh();
    });
    connect(back, "clicked()", function () {
        if (stage > 0) {
            stage--;
            tree.clearSelection();
            refresh();
        }
    });
    connect(next, "clicked()", function () {
        if (stage < 3) {
            stage++;
            tree.clearSelection();
            refresh();
        }
    });
    connect(tree, "doubleClicked(DzListViewItem*,const QPoint&,int)", function (item) {
        if (item && records[item.id].mesh && stage < 3) {
            assignItems([item]);
        }
    });

    try {
        var nodes = Scene.getNodeList();
        for (var i = 0; i < nodes.length; i++) {
            addNode(nodes[i]);
        }
        refresh();
        if (!dialog.exec()) {
            return;
        }
        var hairCount = 0;
        for (var h = 0; h < records.length; h++) {
            if (records[h].role === "garment") hairCount++;
        }
        if (!hairCount && MessageBox.question("No hair is selected. Capture the avatar on its own, to grow hair on it " +
                "in the Hair tool?", title, "&Yes", "&No") !== 0) {
            return;
        }
        var captureOptions = {
            use_animation: animation.checked,
            start_frame: startFrame.value,
            end_frame: endFrame.value,
            output_mode: returnAnimation.checked ? "animation" : "static"
        };
        var selection = [];
        for (var s = 0; s < records.length; s++) {
            if (records[s].role) {
                selection.push({ id: records[s].node.elementID, role: records[s].role });
            }
        }
        var file = new DzFile(folder + "Hair_ExportMesh.dsa");
        if (!file.open(DzFile.ReadOnly)) {
            throw new Error("Could not open the Hair bridge script.");
        }
        var code;
        try {
            code = file.read();
        } finally {
            file.close();
        }
        var script = new DzScript();
        script.setCode("var spinHairFolder = " + JSON.stringify(folder) + ";\n" +
            "var drapeSceneSelection = " + JSON.stringify(selection) + ";\n" +
            "var drapeCaptureOptions = " + JSON.stringify(captureOptions) + ";\n" + code);
        if (!script.execute()) {
            throw new Error(script.errorMessage());
        }
    } catch (error) {
        print(title + ": " + error.message);
        MessageBox.warning(error.message, title, "OK", "");
    }
})();
