// The Spin256 name, logo and icon are not licensed for reuse; see ADDITIONAL_TERMS.md.
// Capture the selected hair and collision meshes and open the Spin Hair Tool.
(function () {
    var title = "Spin Hair Tool";
    var folder = typeof spinHairFolder === "string" ? spinHairFolder :
        String(getScriptFileName()).replace(/\\/g, "/").replace(/[^\/]*$/, "");
    if (!folder) {
        MessageBox.warning("Run this script from its saved file or the Spin Hair Tool menu.", title, "OK", "");
        return;
    }
    var tempFolder;
    var files = [];
    var retainedFiles = [];
    var lineGeometry = null;
    var lineEdits = [];

    function prepareLineGeometry(node) {
        var object = node.getObject();
        var mesh = object ? object.getCachedGeom() : null;
        if (!mesh || mesh.getNumFacets() || typeof mesh.getNumPolylines !== "function" ||
                !mesh.getNumPolylines()) return 0;
        if (!lineGeometry) {
            var library = new DzFile(folder + "Hair Line Geometry.dsa");
            if (!library.open(DzFile.ReadOnly)) throw new Error("Could not open the hair-line capture support.");
            try { lineGeometry = eval(library.read()); }
            finally { library.close(); }
        }
        return lineGeometry.prepare(node, 0, lineEdits);
    }

    function sessionDirectory() {
        var settingsFile = new DzFile(folder + "settings.json");
        var settings = {};
        if (settingsFile.exists()) {
            if (!settingsFile.open(DzFile.ReadOnly)) {
                throw new Error("Could not open settings.json.");
            }
            try {
                settings = JSON.parse(settingsFile.read().replace(/^\uFEFF/, ""));
            } finally {
                settingsFile.close();
            }
        }
        if (!settings || typeof settings !== "object" || settings instanceof Array) {
            throw new Error("settings.json must contain an object.");
        }
        var path = typeof settings.session_folder === "undefined" ? "temp" : settings.session_folder;
        if (typeof path !== "string" || !path.replace(/\s/g, "").length) {
            throw new Error("session_folder must be a nonempty relative or absolute folder path.");
        }
        path = path.replace(/\\/g, "/");
        if (!/^(?:[A-Za-z]:\/|\/)/.test(path)) {
            path = folder + path;
        }
        var root = path.match(/^(?:[A-Za-z]:\/|\/\/|\/)/)[0];
        var parts = path.substring(root.length).split("/");
        var clean = [];
        for (var part = 0; part < parts.length; part++) {
            if (!parts[part] || parts[part] === ".") continue;
            if (parts[part] === "..") {
                if (!clean.length) throw new Error("Session folder is above its filesystem root.");
                clean.pop();
            } else {
                clean.push(parts[part]);
            }
        }
        path = root + clean.join("/");
        var directory = new DzDir(path);
        if (!directory.exists() && !directory.mkpath(path)) {
            throw new Error("Could not create session folder: " + path);
        }
        return path.replace(/\/+$/, "") + "/";
    }

    function pythonExecutable() {
        var file = new DzFile(folder + "settings.json");
        var settings = {};
        if (file.exists()) {
            if (!file.open(DzFile.ReadOnly)) throw new Error("Could not open settings.json.");
            try { settings = JSON.parse(file.read().replace(/^\uFEFF/, "")); }
            finally { file.close(); }
        }
        var path = typeof settings.python_executable === "undefined" ?
            ".venv/Scripts/pythonw.exe" : settings.python_executable;
        if (typeof path !== "string" || !path.replace(/\s/g, "").length) {
            throw new Error("python_executable in settings.json must be a nonempty path.");
        }
        path = path.replace(/\\/g, "/");
        if (!/^(?:[A-Za-z]:\/|\/)/.test(path)) path = folder + path;
        if (!new DzFileInfo(path).exists()) {
            throw new Error("Python was not found at " + path + ". Set python_executable in settings.json.");
        }
        return path;
    }

    function remove(path) {
        var file = new DzFile(path);
        if (file.exists()) {
            file.remove();
        }
    }

    // Each surface's base color and color texture, for the Hair tool's Display. Preview only:
    // a missing value leaves that surface plain and never stops the capture.
    function surfaceLooks(node, materials) {
        var looks = [];
        var shape = node.getObject() ? node.getObject().getCurrentShape() : null;
        for (var k = 0; materials && k < materials.length; k++) {
            var look = { token: materials[k].token, name: materials[k].name, color: null, texture: null };
            try {
                var material = shape ? shape.findMaterial(materials[k].name) : null;
                if (material) {
                    var color = typeof material.getDiffuseColor === "function" ? material.getDiffuseColor() : null;
                    if (color) look.color = [color.red, color.green, color.blue];
                    var map = typeof material.getColorMap === "function" ? material.getColorMap() : null;
                    var file = map && typeof map.getFilename === "function" ? String(map.getFilename()) : "";
                    if (file) look.texture = file;
                }
            } catch (error) {
                print("Hair Tool: no preview look for surface " + materials[k].name + ": " + error.message);
            }
            looks.push(look);
        }
        return looks;
    }

    function writeMesh(node, path, includeSurfaces, captureCounts) {
        if (captureCounts) {
            // Frame changes can expose the temporary base-resolution cache.
            // Finalize for normal viewport quality before taking the snapshot.
            node.update(false);
            node.finalize(false, true);
        }
        var object = node.getObject();
        var mesh = object ? object.getCachedGeom() : null;
        if (!mesh || !mesh.inherits("DzFacetMesh") || !mesh.getNumFacets()) {
            throw new Error("No evaluated polygon mesh found on " + node.getLabel() + ".");
        }
        if (captureCounts) {
            var key = String(node.elementID);
            var expected = captureCounts[key];
            if (expected && (mesh.getNumVertices() !== expected.vertices || mesh.getNumFacets() !== expected.facets)) {
                // Allow queued viewport evaluation to finish, then explicitly
                // finalize again; never mix base and subdivided frame snapshots.
                processEvents();
                node.update(false);
                node.finalize(false, true);
                object = node.getObject();
                mesh = object ? object.getCachedGeom() : null;
                if (!mesh || mesh.getNumVertices() !== expected.vertices || mesh.getNumFacets() !== expected.facets) {
                    throw new Error("DAZ capture resolution changed for " + node.getLabel() + " at frame " + Scene.getFrame() +
                        ". Expected " + expected.vertices + " vertices and " + expected.facets + " facets after evaluation. " +
                        "Keep Resolution Level and SubDivision Level constant across the timeline.");
                }
            }
            if (!expected) captureCounts[key] = { vertices: mesh.getNumVertices(), facets: mesh.getNumFacets() };
        }
        var lines = [];
        var metadata = null;
        var uvCount = 0;
        if (includeSurfaces) {
            metadata = {
                vertex_count: mesh.getNumVertices(), object_id: object.elementID,
                shape_id: object.getCurrentShape().elementID, materials: []
            };
        }
        for (var i = 0; i < mesh.getNumVertices(); i++) {
            var point = mesh.getVertex(i);
            lines.push("v " + point.x + " " + point.y + " " + point.z);
        }
        if (includeSurfaces) {
            var uvs = mesh.getUVs();
            uvCount = uvs ? uvs.getNumValues() : 0;
            for (var u = 0; u < uvCount; u++) {
                var uv = uvs.getPnt2Vec(u);
                lines.push("vt " + uv.x + " " + uv.y);
            }
            for (var m = 0; m < mesh.getNumMaterialGroups(); m++) {
                var group = mesh.getMaterialGroup(m);
                metadata.materials.push({ token: "drape_surface_" + m, name: group.name });
            }
            lines.push("s 1");
        }
        var material = -1;
        for (var j = 0; j < mesh.getNumFacets(); j++) {
            var facet = mesh.getFacet(j);
            var indices = [facet.vertIdx1, facet.vertIdx2, facet.vertIdx3];
            var uvIndices = [facet.uvwIdx1, facet.uvwIdx2, facet.uvwIdx3];
            if (facet.vertIdx4 >= 0) {
                indices.push(facet.vertIdx4);
                uvIndices.push(facet.uvwIdx4);
            }
            if (includeSurfaces && !metadata.materials[facet.materialIndex]) {
                throw new Error("A garment polygon has no material group.");
            }
            if (includeSurfaces && facet.materialIndex !== material) {
                material = facet.materialIndex;
                lines.push("usemtl " + metadata.materials[material].token);
            }
            var useUV = includeSurfaces && uvCount > 0 && uvIndices.every(function (index) {
                return index >= 0 && index < uvCount;
            });
            lines.push("f " + indices.map(function (index, corner) {
                return (index + 1) + (useUV ? "/" + (uvIndices[corner] + 1) : "");
            }).join(" "));
        }
        var payload = lines.join("\n") + "\n";
        var file = new DzFile(path);
        if (!file.open(DzFile.WriteOnly | DzFile.Truncate)) {
            throw new Error("Could not create the mesh file for " + node.getLabel() + ".");
        }
        try {
            if (file.writeUtf8(payload) !== payload.length) {
                throw new Error("Could not write the full mesh for " + node.getLabel() + ".");
            }
        } finally {
            file.close();
        }
        return metadata;
    }

    // Register a live capture, start the helper detached and hand results to
    // the Spin Tools receive window, which runs Receive Hair Result.dsa.
    function launchLive(sessionPath, sharedReceiver) {
        var hairSettings = new DzAppSettings("Spin256/Hair/" + App.getApplicationDataName());
        var previousReturn = hairSettings.getStringValue("LiveReturn", "");
        if (!hairSettings.setStringValue("LiveReturn", JSON.stringify({ session: sessionPath }))) {
            throw new Error("Could not register this capture for the Spin Tools receive window.");
        }
        var receiver = new DzAppSettings("Spin256/Receiver/" + App.getApplicationDataName());
        var previousCaptures = receiver.getStringValue("Captures", "");
        var data;
        try { data = JSON.parse(previousCaptures || "{}"); }
        catch (error) { data = {}; }
        var captures = data && data.version === 1 && Array.isArray(data.captures) ? data.captures : [];
        var kept = [];
        for (var i = 0; i < captures.length; i++) {
            if (captures[i] && captures[i].tool !== "hair") kept.push(captures[i]);
        }
        kept.push({ tool: "hair", title: "Spin Hair", session: sessionPath, folder: folder,
            receive_script: "Receive Hair Result.dsa", folder_variable: "spinHairFolder",
            once_variable: "spinHairReceiveOnce", settings: "Spin256/Hair/", state_key: "LiveReturn",
            registered: new Date().getTime() });
        try {
            if (!receiver.setStringValue("Captures", JSON.stringify({ version: 1, captures: kept }))) {
                throw new Error("Could not register this capture for the Spin Tools receive window.");
            }
            launchHelper([pythonExecutable(), folder + "app/live_return.py", sessionPath]);
        } catch (error) {
            hairSettings.setStringValue("LiveReturn", previousReturn);
            receiver.setStringValue("Captures", previousCaptures);
            throw error;
        }
        // The helper owns this capture after launch and reads it across sends.
        retainedFiles = files.slice();
        App.postScriptEvent(false, sharedReceiver);
    }

    function launchHelper(args) {
        var process = new DzProcess(args);
        process.workingDirectory = folder;
        if (!process.start()) {
            throw new Error("Could not launch the Hair helper. Check python_executable in settings.json.");
        }
        while (process.running) {
            processEvents();
            sleep(40);
        }
        if (!process.normalExit || Number(process.exitStatus) !== 0) {
            throw new Error("The Hair helper exited with an error.");
        }
    }

    function launchSelection(selection) {
        var options = typeof drapeCaptureOptions !== "undefined" ? drapeCaptureOptions : {};
        var animated = !!options.use_animation;
        var start = animated ? Number(options.start_frame) : Scene.getFrame();
        var end = animated ? Number(options.end_frame) : start;
        if (animated && (!isFinite(start) || !isFinite(end) ||
                Math.floor(start) !== start || Math.floor(end) !== end || end <= start)) {
            throw new Error("Choose an integer start and end frame, with the end later than the start.");
        }
        var outputMode = options.output_mode || "static";
        if (outputMode !== "static" && outputMode !== "animation") {
            throw new Error("Unknown Hair output preference.");
        }
        var prefix = tempFolder + ".session-" + new Date().getTime() + "-" +
            Math.floor(Math.random() * 1000000);
        var session = {
            version: 2, frame: start, mode: animated ? "timeline" : "current_frame",
            output_mode: outputMode, meshes: [], session_id: prefix,
            result_path: prefix + "-result.json", water_return_path: prefix + "-water.obj"
        };
        files.push(session.result_path, session.result_path + ".tmp");
        files.push(session.water_return_path, session.water_return_path + ".tmp");
        // The helper stays open and results go through the Spin Tools receive window.
        var suiteFolder = folder.replace(/[^\/]*\/$/, "");
        var sharedReceiver = suiteFolder + "Receive Spin Tools Results.dsa";
        if (!suiteFolder || suiteFolder === folder || !new DzFile(sharedReceiver).exists() ||
                !new DzFile(folder + "Receive Hair Result.dsa").exists()) {
            throw new Error("Spin Hair Tool must run from its Spin Tools folder: the shared receive window " +
                "(Receive Spin Tools Results.dsa) or Receive Hair Result.dsa is missing. Reinstall Spin Tools.");
        }
        session.live_return = true;
        if (animated) {
            session.start_frame = start;
            session.end_frame = end;
            var frameTicks = Scene.getTimeStep().valueOf();
            session.fps = 4800 / frameTicks;
            if (!isFinite(session.fps) || session.fps <= 0) {
                throw new Error("Could not determine the DAZ timeline frame rate.");
            }
            var timeline = Scene.getAnimRange();
            var firstFrame = Math.ceil(timeline.start.valueOf() / frameTicks - 1e-8);
            var lastFrame = Math.floor(timeline.end.valueOf() / frameTicks + 1e-8);
            if (!isFinite(firstFrame) || !isFinite(lastFrame) || start < firstFrame || end > lastFrame) {
                throw new Error("Choose frames within the DAZ timeline, " + firstFrame + " through " + lastFrame + ".");
            }
        }
        var seen = {};
        var garmentCount = 0;
        var colliderCount = 0;
        for (var i = 0; i < selection.length; i++) {
            var entry = selection[i];
            if (entry.role !== "avatar" && entry.role !== "avatar_attachment" && entry.role !== "collision" && entry.role !== "fixed" && entry.role !== "moving" && entry.role !== "garment") {
                throw new Error("The scene selection contains an unknown role.");
            }
            if (seen[entry.id]) {
                throw new Error("A scene object has been assigned more than one role.");
            }
            seen[entry.id] = true;
            var node = Scene.findNodeByElementID(entry.id);
            if (!node) {
                throw new Error("A selected scene object no longer exists. Open the scene selector again.");
            }
            session.meshes.push({ id: entry.id, role: entry.role, label: node.getLabel() });
            if (entry.role === "garment") {
                garmentCount++;
            } else {
                colliderCount++;
            }
        }
        // Hair is optional: an avatar on its own is captured to grow hair on it.
        if (!colliderCount) {
            throw new Error("Assign the avatar.");
        }
        var originalTime = Scene.getTime();
        var captureCounts = animated ? {} : null;
        startProgress("Capturing Hair inputs", end - start + 1, true, true);
        try {
            for (var frame = start; frame <= end; frame++) {
                if (animated) {
                    Scene.setFrame(frame);
                    Scene.update();
                }
                for (var m = 0; m < session.meshes.length; m++) {
                    var meshEntry = session.meshes[m];
                    if (frame !== start && meshEntry.role === "garment") {
                        continue;
                    }
                    var samplePath = prefix + "-" + m + "-" + frame + ".obj";
                    files.push(samplePath);
                    var meshNode = Scene.findNodeByElementID(meshEntry.id);
                    if (!meshNode) {
                        throw new Error("A selected object was removed during capture.");
                    }
                    var lineSides = meshEntry.role === "garment" ? prepareLineGeometry(meshNode) : 0;
                    var metadata = writeMesh(meshNode, samplePath, meshEntry.role === "garment", captureCounts);
                    if (frame === start) {
                        if (lineSides) meshEntry.line_tessellation_sides = lineSides;
                        meshEntry.path = samplePath;
                        if (metadata) {
                            meshEntry.vertex_count = metadata.vertex_count;
                            meshEntry.object_id = metadata.object_id;
                            meshEntry.shape_id = metadata.shape_id;
                            meshEntry.materials = metadata.materials;
                            meshEntry.return_path = prefix + "-hair-" + m + ".obj";
                            files.push(meshEntry.return_path, meshEntry.return_path + ".tmp");
                            meshEntry.animation_path = prefix + "-hair-" + m + ".fbx";
                            files.push(meshEntry.animation_path, meshEntry.animation_path + ".tmp");
                        }
                        if (animated && meshEntry.role !== "garment") {
                            meshEntry.samples = [];
                        }
                        // Display looks: the hair's surfaces; the avatar written once more with its UVs and surfaces.
                        try {
                            if (meshEntry.role === "garment") {
                                meshEntry.looks = surfaceLooks(meshNode, meshEntry.materials);
                            } else if (meshEntry.role === "avatar") {
                                var lookPath = prefix + "-" + m + "-look.obj";
                                files.push(lookPath);
                                var avatarLook = writeMesh(meshNode, lookPath, true, null);
                                meshEntry.look_path = lookPath;
                                meshEntry.looks = surfaceLooks(meshNode, avatarLook.materials);
                            }
                        } catch (lookError) {
                            print("Hair Tool: no display looks for " + meshNode.getLabel() + ": " + lookError.message);
                        }
                    }
                    if (animated && meshEntry.role !== "garment") {
                        meshEntry.samples.push(samplePath);
                    }
                }
                stepProgress();
                processEvents();
                if (progressIsCancelled()) {
                    return;
                }
            }
        } finally {
            if (lineGeometry) lineGeometry.restore(lineEdits);
            if (animated) {
                Scene.setTime(originalTime);
                Scene.update();
            }
            finishProgress();
        }
        var sessionPath = prefix + ".json";
        files.push(sessionPath);
        var file = new DzFile(sessionPath);
        if (!file.open(DzFile.WriteOnly | DzFile.Truncate)) {
            throw new Error("Could not create the Hair session.");
        }
        try {
            var payload = JSON.stringify(session);
            if (file.writeUtf8(payload) <= 0) {
                throw new Error("Could not write the Hair session.");
            }
        } finally {
            file.close();
        }
        print("Hair Tool: opening " + garmentCount + " hair mesh(es) and " + colliderCount +
            " collision mesh(es), " + (animated ? "frames " + start + " to " + end : "frame " + start) + ".");
        launchLive(sessionPath, sharedReceiver);
    }

    try {
        tempFolder = sessionDirectory();
        if (typeof drapeSceneSelection !== "undefined") {
            launchSelection(drapeSceneSelection);
            return;
        }
        throw new Error("Open Spin Hair Tool from Scripts > Spin Tools > Hair Tool... to choose the hair and avatar.");
    } catch (error) {
        print(title + ": " + error.message);
        MessageBox.warning(error.message, title, "OK", "");
    } finally {
        for (var f = 0; f < files.length; f++) {
            if (retainedFiles.indexOf(files[f]) < 0) {
                remove(files[f]);
            }
        }
    }
})();


