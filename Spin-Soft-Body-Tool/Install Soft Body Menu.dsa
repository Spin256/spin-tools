// Register the scene-selection launcher in DAZ Studio's Scripts menu.
(function () {
    var title = "Install Spin Soft Body Tool menu";
    // Inside "Install Spin Tools Menu.dsa" the suite shows one summary instead.
    var quiet = false;
    try { quiet = new DzAppSettings("Spin256/Installer").getStringValue("Quiet", "") === "1"; } catch (e) {}
    var folder = String(getScriptFileName()).replace(/\\/g, "/").replace(/[^\/]*$/, "");
    function installAction(manager, menu, filename, label, description) {
        var path = folder + filename;
        if (!new DzFileInfo(path).exists()) {
            throw new Error("Could not find " + path);
        }
        // Read the launcher on every click so future updates need no reinstall.
        var launcher = "(function () {" +
            "var file = new DzFile(" + JSON.stringify(path) + ");" +
            "if (!file.open(DzFile.ReadOnly)) {" +
            "MessageBox.warning('Cannot open the soft body launcher script.', 'Spin Soft Body Tool', 'OK', ''); return; }" +
            "var code = file.read(); file.close();" +
            "var script = new DzScript(); script.setCode('var spinSoftBodyFolder = ' + " +
            JSON.stringify(JSON.stringify(folder)) + " + ';\\n' + code);" +
            "if (!script.execute()) {" +
            "MessageBox.warning(script.errorMessage(), 'Spin Soft Body Tool', 'OK', ''); }" +
            "})();";
        var action = "";
        for (var i = 0; i < manager.getNumCustomActions(); i++) {
            var file = String(manager.getCustomActionFile(i)).replace(/\\/g, "/");
            if (file.toLowerCase() === path.toLowerCase() ||
                    manager.getCustomActionDesc(i) === description) {
                manager.setCustomActionScript(i, launcher, false);
                manager.setCustomActionText(i, label);
                if (typeof manager.setCustomActionDescription === "function") {
                    manager.setCustomActionDescription(i, description);
                }
                action = manager.getCustomActionName(i);
                break;
            }
        }
        if (!action) {
            action = manager.addCustomAction(label, description, launcher, false, "", "");
        }
        if (!action) {
            throw new Error("DAZ Studio could not register the soft body launcher.");
        }
        var items = menu.getItemList();
        var installed = false;
        for (var j = 0; j < items.length; j++) {
            if (items[j].type == DzActionMenuItem.CustomAction && items[j].action == action) {
                installed = true;
                break;
            }
        }
        if (!installed) menu.insertCustomAction(action, -1);
    }
    try {
        if (!folder) throw new Error("Run the saved Install Soft Body Menu.dsa file from the tool folder.");
        var manager = MainWindow.getActionMgr();
        var scriptsMenu = manager.getMenu().getSubMenu("&Scripts");
        var menu = scriptsMenu.findOrCreateSubMenu("Spin Tools");
        installAction(manager, menu, "Soft Body Tool.dsa", "Soft Body Tool...",
            "Select scene objects and open Spin Soft Body Tool");
        if (!quiet) MessageBox.information("Open Soft Body Tool under Scripts > Spin Tools to capture or receive a result.", title, "OK");
    } catch (error) {
        if (quiet) throw error;
        MessageBox.warning(error.message, title, "OK", "");
    }
})();
